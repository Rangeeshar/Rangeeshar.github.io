---
import { projects } from '../data/profile';
import { highlight } from '../lib/text';
import VideoSearch from './demos/VideoSearch.astro';
import GmailRules from './demos/GmailRules.astro';
import MediaPipeline from './demos/MediaPipeline.astro';
import SplitBill from './demos/SplitBill.astro';
import Words from './Words.astro';

const demos = { 'video-search': VideoSearch, 'gmail-rules': GmailRules, 'media-pipeline': MediaPipeline, 'split-bill': SplitBill };
const featured = projects.filter((p) => p.demo);
const more = projects.filter((p) => !p.demo);
---

<section id="workloads" class="hop">
  <div class="wrap">
    <header class="hop-head">
      <span class="tag">workloads <span>· +41 ms</span></span>
      <Words as="h2" text="Work that runs" />
      <p>No screenshots. Each project below runs a small live version of what it actually does.</p>
    </header>

    <div class="work">
      {featured.map((p) => {
        const Demo = demos[p.demo!];
        return (
          <article class="work-item" id={`work-${p.id}`}>
            <div class="work-copy">
              <p class="label" data-reveal>{p.kicker}</p>
              <Words as="h3" text={p.name} />
              <p class="work-summary" data-reveal style="--d:120ms">{p.summary}</p>
              <ul class="work-points" data-reveal style="--d:220ms">{p.points.map((pt) => <li set:html={highlight(pt)} />)}</ul>
              <ul class="chips">{p.stack.map((s) => <li class="chip">{s}</li>)}</ul>
              {p.link && <a class="work-link mono" href={p.link.href} target="_blank" rel="noopener">{p.link.label} ↗</a>}
            </div>
            <div class="work-stage" data-boot><Demo /></div>
          </article>
        );
      })}
    </div>

    <h3 class="more-title">More workloads</h3>
    <div class="more">
      {more.map((p) => (
        <article class="more-item" data-reveal>
          <p class="label">{p.kicker}</p>
          <h4>{p.name}</h4>
          <p class="muted">{p.summary}</p>
          <ul class="chips">{p.stack.map((s) => <li class="chip">{s}</li>)}</ul>
          {p.link && <a class="work-link mono" href={p.link.href} target="_blank" rel="noopener">{p.link.label} ↗</a>}
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .work { display: grid; gap: clamp(64px, 9vw, 120px); }
  .work-item { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 32px 56px; align-items: start; }
  /* On wide screens the demo stays pinned while its copy scrolls past. */
  @media (min-width: 981px) {
    .work-item { min-height: 92vh; }
    .work-stage { position: sticky; top: calc(var(--header-h) + 32px); }
    .work-copy { padding-top: 8vh; }
  }
  @media (max-width: 980px) { .work-item { grid-template-columns: minmax(0, 1fr); } }
  .work-copy { display: grid; gap: 16px; align-content: start; min-width: 0; }
  .work-copy h3 { font-size: clamp(32px, 4vw, 48px); line-height: 0.98; font-stretch: 78%; }
  .work-summary { font-size: 19px; line-height: 1.5; }
  .work-points { display: grid; gap: 8px; padding-left: 18px; color: var(--muted); }
  .work-link { font-size: 14px; color: var(--accent); width: fit-content; }
  .work-stage { min-width: 0; }
  /* A demo "boots" like a screen powering on: a bright line opens into the full stage. */
  .work-stage[data-boot] > .stage { transition: clip-path 900ms var(--ease-out), filter 900ms var(--ease-out); }
  .reveal-ready .work-stage[data-boot]:not(.in) > .stage { clip-path: inset(49.5% 0 49.5% 0); filter: brightness(1.8); }

  .more-title { margin: clamp(72px, 10vw, 120px) 0 24px; }
  .more { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 720px) { .more { grid-template-columns: minmax(0, 1fr); } }
  .more-item { display: grid; gap: 10px; align-content: start; padding: 22px; border: 1px solid var(--line); border-radius: 4px; }
  .more-item h4 { margin: 0; font: 700 24px/1.1 var(--display); font-stretch: 86%; }
</style>
