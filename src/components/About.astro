---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import { person } from '../data/profile';
import Words from './Words.astro';

const years = new Date().getFullYear() - person.careerStart[0];
// Scroll choreography: route i owns the slice [i * SLICE, (i + 1) * SLICE] of the scene's progress.
const SLICE = 0.3;
// Fan-out geometry in the SVG's 400 × 360 box.
const routeY = [60, 180, 300];
const input = 'M0 180 H150';
const outputs = routeY.map((y) => `M210 180 C300 180 290 ${y} 400 ${y}`);
---

<section id="gateway" class="hop pin gateway" style="--pin:320vh" data-gateway data-slice={SLICE}>
  <div class="pin-stage">
    <div class="wrap">
      <header class="hop-head">
        <span class="tag">gateway <span>· +3 ms</span></span>
        <Words as="h2" text="Three routes, one engineer" />
      </header>

      <div class="gw">
        <div class="gw-diagram" aria-hidden="true">
          <svg viewBox="0 0 400 360" preserveAspectRatio="xMidYMid meet">
            <path class="gw-wire in" d={input} pathLength="1" />
            {outputs.map((d, i) => <path class="gw-wire out" d={d} pathLength="1" style={`--a:${i * SLICE}`} data-out={i} />)}
            <rect class="gw-box" x="150" y="150" width="60" height="60" />
            <text class="gw-boxlabel" x="180" y="232">gateway</text>
            {routeY.map((y, i) => <text class="gw-routelabel" x="396" y={y - 10} style={`--a:${i * SLICE}`}>{person.routes[i].path}</text>)}
            <circle class="gw-packet" r="6" cx="0" cy="180" data-packet />
          </svg>
          <p class="gw-status mono tnum" data-status>3 of 3 routes served</p>
        </div>

        <div class="gw-copy">
          <div class="badge" data-reveal>
            <Image src={portrait} alt="Portrait of Rangeesh Rajagopal" width={64} height={64} densities={[1, 2]} class="badge-photo" loading="lazy" />
            <dl class="badge-meta mono">
              <div><dt>role</dt><dd>{person.role} @ {person.company}</dd></div>
              <div><dt>region</dt><dd>{person.location}</dd></div>
              <div><dt>uptime</dt><dd class="tnum">{years}+ years</dd></div>
            </dl>
          </div>
          <ol class="routes">
            {person.routes.map((r, i) => (
              <li class="route" style={`--a:${i * SLICE}`}>
                <span class="route-path mono"><span class="verb">GET</span> {r.path}</span>
                <Words as="p" mode="scrub" text={r.text} from={i * SLICE + 0.04} to={(i + 1) * SLICE - 0.02} />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { scrub } from '../lib/motion';

  // Moves the request packet: in through the gateway, then out along the route whose slice is playing.
  const root = document.querySelector<HTMLElement>('[data-gateway]');
  if (root) {
    const slice = Number(root.dataset.slice);
    const input = root.querySelector<SVGPathElement>('.gw-wire.in')!;
    const outs = [...root.querySelectorAll<SVGPathElement>('[data-out]')];
    const packet = root.querySelector<SVGCircleElement>('[data-packet]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const paths = [...root.querySelectorAll<SVGTextElement>('.gw-routelabel')].map((t) => t.textContent);
    const place = (path: SVGPathElement, t: number) => {
      const pt = path.getPointAtLength(path.getTotalLength() * t);
      packet.setAttribute('cx', String(pt.x));
      packet.setAttribute('cy', String(pt.y));
    };
    scrub(root, (p) => {
      const done = p >= outs.length * slice;
      const i = Math.min(outs.length - 1, Math.floor(p / slice));
      const local = Math.min(1, (p - i * slice) / slice);
      // First 35% of a slice: travel the input wire; the rest: travel route i.
      if (local < 0.35) place(input, local / 0.35);
      else place(outs[i], (local - 0.35) / 0.65);
      packet.style.opacity = done ? '0' : '1';
      status.textContent = done ? `${outs.length} of ${outs.length} routes served` : `routing ${paths[i]} · ${i + 1} of ${outs.length}`;
    });
  }
</script>

<style is:global>
  .pin.hop { padding-block: 0; }
  .pin .pin-stage { padding-block: clamp(64px, 9vw, 112px); }
  @media (min-width: 900px) and (min-height: 760px) and (prefers-reduced-motion: no-preference) {
    .pin .pin-stage { padding-block: 24px; }
  }

  .gw { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 32px 64px; align-items: center; }
  @media (max-width: 899px) { .gw { grid-template-columns: minmax(0, 1fr); } }
  .gw-diagram { display: grid; gap: 10px; }
  .gw-diagram svg { width: 100%; max-height: 52vh; overflow: visible; }
  .gw-wire { fill: none; stroke: var(--line); stroke-width: 1.5; }
  .gw-wire.in { stroke: var(--accent); stroke-dasharray: 1; stroke-dashoffset: calc(1 - min(1, var(--p) * 8)); }
  .gw-wire.out { stroke: var(--accent); stroke-dasharray: 1; stroke-dashoffset: calc(1 - clamp(0, (var(--p) - var(--a)) * 4, 1)); }
  .gw-box { fill: var(--surface); stroke: var(--hot); stroke-width: 1.5; }
  .gw-boxlabel, .gw-routelabel { font: 500 12px var(--mono); fill: var(--muted); }
  .gw-boxlabel { text-anchor: middle; }
  .gw-routelabel { text-anchor: end; fill: var(--accent); opacity: clamp(0.25, calc((var(--p) - var(--a)) * 5), 1); }
  .gw-packet { fill: var(--hot); filter: drop-shadow(0 0 6px var(--hot)); transition: opacity 200ms; }
  .gw-status { font-size: 12px; color: var(--muted); }

  .gw-copy { display: grid; gap: 28px; min-width: 0; }
  .badge { display: flex; align-items: center; gap: 16px; padding: 14px 16px; border: 1px solid var(--line); background: var(--surface); border-radius: 4px; width: fit-content; max-width: 100%; }
  .badge-photo { width: 64px; height: 64px; flex: none; object-fit: cover; border-radius: 50%; }
  .badge-meta { display: grid; gap: 3px; margin: 0; font-size: 12.5px; min-width: 0; }
  .badge-meta div { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 10px; }
  .badge-meta dt { color: var(--muted); }
  .badge-meta dd { margin: 0; }

  .routes { list-style: none; display: grid; }
  .route { display: grid; gap: 6px; padding-block: 16px; border-top: 1px solid var(--line); }
  .route p { font-size: clamp(20px, 2.2vw, 27px); line-height: 1.35; }
  .route-path { font-size: 13px; color: var(--accent); opacity: clamp(0.35, calc((var(--p) - var(--a)) * 6), 1); }
  .route-path .verb { color: var(--muted); }
</style>
