---
import { person } from '../data/profile';
---

<section id="edge" class="hero">
  <div class="wrap">
    <p class="hero-eyebrow mono"><span class="dot" aria-hidden="true"></span>{person.role} @ {person.company} · {person.location}</p>
    <div class="hero-grid">
      <h1>Rangeesh<br />Rajagopal</h1>
      <div class="hero-side">
        <p class="hero-lede">{person.lede}</p>
        <div class="hero-cta">
          <a class="btn primary" href="#workloads">View work</a>
          <a class="btn" href="#response">Open a connection</a>
        </div>
      </div>
    </div>

    <figure class="topo stage" data-scene="topology">
      <figcaption class="topo-tag label">Live system · click or tap to send your own request</figcaption>
      <canvas aria-hidden="true"></canvas>
      <div class="topo-bar">
        <p class="topo-readout mono tnum" data-readout aria-live="off">you → edge 3 ms → gateway 2 ms → fastapi 31 ms → redis 1 ms → <span class="ok">200 OK</span> · <b>37 ms</b></p>
        <button class="btn small" type="button" data-send>Send request</button>
      </div>
    </figure>

    <dl class="hero-facts mono tnum">
      {person.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </div>
</section>

<script>
  import { activate } from '../lib/scene';
  activate('[data-scene="topology"]', () => import('../scenes/topology'));
</script>

<style is:global>
  .hero { padding-block: clamp(40px, 7vw, 88px) clamp(56px, 8vw, 96px); }
  .hero-eyebrow { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--muted); margin-bottom: clamp(20px, 3vw, 32px); }
  .hero-eyebrow .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 20%, transparent); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 28px 56px; align-items: end; margin-bottom: clamp(36px, 5vw, 56px); }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } }
  .hero h1 { font-size: clamp(64px, 12.5vw, 168px); line-height: 0.84; font-stretch: 75%; font-weight: 750; letter-spacing: -0.025em; }
  .hero-side { display: grid; gap: 24px; padding-bottom: 8px; }
  .hero-lede { font-size: clamp(19px, 2vw, 22px); line-height: 1.45; max-width: 34ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; }

  .topo { margin: 0; }
  .topo canvas { display: block; width: 100%; height: 380px; cursor: crosshair; touch-action: manipulation; }
  .topo-tag { position: absolute; top: 12px; left: 14px; right: 14px; letter-spacing: 0.06em; }
  .topo-bar { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; justify-content: space-between; padding: 10px 14px; border-top: 1px solid var(--line); background: var(--bg); }
  .topo-readout { font-size: 12.5px; color: var(--muted); min-width: 0; overflow-wrap: anywhere; }
  .topo-readout b { color: var(--hot); font-weight: 500; }
  .topo-readout .ok { color: var(--ok); }

  .hero-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin: 28px 0 0; }
  @media (max-width: 720px) { .hero-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .hero-facts div { display: grid; gap: 4px; padding-top: 12px; border-top: 1px solid var(--line); }
  .hero-facts dt { font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .hero-facts dd { margin: 0; font-size: clamp(16px, 1.8vw, 20px); font-weight: 500; }
</style>
