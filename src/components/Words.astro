---
// Splits text into word spans for motion.
//  mode="rise":  words slide up out of a mask when the element scrolls into view.
//  mode="scrub": words brighten one by one as the parent scene's --p moves through [from, to].
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'span';
  mode?: 'rise' | 'scrub';
  from?: number;
  to?: number;
  class?: string;
}
const { text, as: Tag = 'span', mode = 'rise', from = 0, to = 1, class: cls } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
const k = (i: number) => (from + ((to - from) * i) / Math.max(1, words.length)).toFixed(4);
---

<Tag class:list={[cls, mode === 'rise' ? 'split' : 'scrubtext']}>
  {words.map((w, i) => (
    mode === 'rise'
      ? <><span class="w" style={`--i:${i}`}><i>{w}</i></span>{' '}</>
      : <><span class="w" style={`--k:${k(i)}`}>{w}</span>{' '}</>
  ))}
</Tag>
