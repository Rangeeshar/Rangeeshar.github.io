---
import { roles, fmtRange, fmtMonth, type YearMonth } from '../data/profile';
import { highlight } from '../lib/text';

// Time axis in months, from the first role to the start of next year.
const now = new Date();
const today: YearMonth = [now.getFullYear(), now.getMonth() + 1];
const m = ([y, mo]: YearMonth) => y * 12 + mo - 1;
const T0 = m(roles[0].start);
const T1 = (now.getFullYear() + 1) * 12;
const pct = (n: number) => `${((n / (T1 - T0)) * 100).toFixed(3)}%`;
// Inclusive month count, the way LinkedIn reports tenure.
const months = (s: YearMonth, e: YearMonth) => m(e) - m(s) + 1;
const dur = (n: number) => [Math.floor(n / 12) && `${Math.floor(n / 12)}y`, n % 12 && `${n % 12}m`].filter(Boolean).join(' ');

const rows = roles.map((r, i) => {
  const len = months(r.start, r.end ?? today);
  return {
    ...r,
    len,
    style: [
      `--l:${pct(m(r.start) - T0)}`,
      `--w:${pct(len)}`,
      `--i:${i}`,
      r.partTimeUntil ? `--pt:${((months(r.start, r.partTimeUntil) / len) * 100).toFixed(2)}%` : '',
    ].filter(Boolean).join(';'),
  };
});
const startYear = roles[0].start[0];
const ticks = Array.from({ length: now.getFullYear() + 1 - startYear + 1 }, (_, k) => startYear + k)
  .filter((y) => (y - startYear) % 2 === 0)
  .map((y) => ({ label: `'${String(y).slice(2)}`, left: pct(y * 12 - T0) }));
const newestFirst = [...roles].reverse();
---

<section id="services" class="hop">
  <div class="wrap">
    <header class="hop-head">
      <span class="tag">services <span>· +5 ms</span></span>
      <h2>Eight years, one trace</h2>
      <p>My career as a distributed trace. Each role is a span, overlapping roles run in parallel, and the current role is still in flight. Select a span to read its attributes.</p>
    </header>

    <div class="trace" data-trace data-t0={T0} data-t1={T1}>
      <div class="trace-chart">
        <div class="trace-axis" aria-hidden="true">
          <span class="label">service</span>
          <span class="trace-ticks">{ticks.map((t) => <span style={`left:${t.left}`}>{t.label}</span>)}</span>
          <span class="label dur">dur</span>
        </div>
        <ol class="trace-rows">
          {rows.map((r) => (
            <li>
              <a class:list={['span', { open: !r.end }]} href={`#role-${r.id}`} data-span={r.id} style={r.style}
                 data-start={m(r.start)} aria-label={`${r.title}, ${r.company}, ${fmtRange(r.start, r.end)}`}>
                <span class="svc">{r.svc}</span>
                <span class="lane"><span class:list={['bar', { pt: r.partTimeUntil }]}></span></span>
                <span class="dur tnum">{dur(r.len)}{!r.end && '+'}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="trace-legend label"><i class="sw solid"></i> full-time <i class="sw hatched"></i> part-time <i class="sw live"></i> in flight</p>
      </div>

      <div class="trace-panels">
        {newestFirst.map((r) => (
          <article class="role" id={`role-${r.id}`} data-panel={r.id}>
            <p class="label">{r.svc}</p>
            <h3>{r.title}</h3>
            <p class="role-where">{r.company} · {r.location}</p>
            <p class="role-when mono tnum">{fmtRange(r.start, r.end)}</p>
            {r.positions && (
              <ul class="role-positions mono">
                {r.positions.map((p) => <li>{p.title}{p.note && ` (${p.note})`} · {fmtMonth(p.start)} – {fmtMonth(p.end)}</li>)}
              </ul>
            )}
            <dl class="role-attrs mono tnum">
              {r.attrs.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
            </dl>
            {r.bullets.length > 0 && <ul class="role-bullets">{r.bullets.map((b) => <li set:html={highlight(b)} />)}</ul>}
            {r.stack.length > 0 && <ul class="chips">{r.stack.map((s) => <li class="chip">{s}</li>)}</ul>}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initTrace } from '../scenes/trace';
  initTrace();
</script>

<style is:global>
  .trace { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px 48px; align-items: start; }
  @media (max-width: 980px) { .trace { grid-template-columns: minmax(0, 1fr); } }
  .trace-chart { display: grid; gap: 4px; min-width: 0; }
  .trace-axis, .span { display: grid; grid-template-columns: 150px minmax(0, 1fr) 60px; gap: 14px; align-items: center; }
  .trace-ticks { position: relative; height: 18px; font: 400 11px var(--mono); color: var(--muted); }
  .trace-ticks span { position: absolute; transform: translateX(-50%); }
  .trace-ticks span:first-child { transform: none; }
  .trace-axis .dur, .span .dur { text-align: right; }
  .trace-rows { list-style: none; display: grid; }
  .span { padding: 9px 0; text-decoration: none; color: var(--muted); border-top: 1px dashed var(--line); }
  .span:hover, .span[aria-selected='true'] { color: var(--ink); }
  .span .svc { font: 400 13px var(--mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .span .dur { font: 400 12.5px var(--mono); }
  .span .lane { position: relative; height: 16px; }
  .span .bar {
    position: absolute; top: 2px; bottom: 2px; left: var(--l); width: var(--w); min-width: 3px;
    color: var(--accent); background: currentColor; border-radius: 1px; opacity: 0.6;
    transform-origin: left; transition: opacity var(--dur-ui), color var(--dur-ui);
  }
  .span:hover .bar { opacity: 0.85; }
  .span[aria-selected='true'] .bar { opacity: 1; color: var(--hot); }
  .span .bar.pt {
    background:
      repeating-linear-gradient(135deg, currentColor 0 2px, transparent 2px 5px) left / var(--pt) 100% no-repeat,
      linear-gradient(currentColor, currentColor) right / calc(100% - var(--pt)) 100% no-repeat;
    box-shadow: inset 0 0 0 1px currentColor;
  }
  .span.open .bar { background-image: linear-gradient(90deg, transparent 65%, var(--bg)); }
  .span.open .bar::after {
    content: ''; position: absolute; right: -4px; top: 50%; width: 8px; height: 8px; margin-top: -4px;
    border-radius: 50%; background: currentColor; animation: trace-live 1.2s var(--ease-io) infinite alternate;
  }
  @keyframes trace-live { to { opacity: 0.2; } }
  .trace.play .bar { animation: trace-grow var(--dur-scene) var(--ease-out) both; animation-delay: calc(var(--i) * 110ms); }
  @keyframes trace-grow { from { transform: scaleX(0); } }
  .trace-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 14px; letter-spacing: 0.04em; }
  .trace-legend .sw { display: inline-block; width: 18px; height: 8px; color: var(--accent); background: currentColor; }
  .trace-legend .sw.hatched { background: repeating-linear-gradient(135deg, currentColor 0 2px, transparent 2px 5px); box-shadow: inset 0 0 0 1px currentColor; }
  .trace-legend .sw.live { width: 8px; border-radius: 50%; color: var(--hot); }
  @media (max-width: 560px) { .trace-axis, .span { grid-template-columns: 104px minmax(0, 1fr) 50px; gap: 8px; } .span .svc { font-size: 12px; } }

  .trace-panels { display: grid; gap: 28px; min-width: 0; }
  .role { display: grid; gap: 10px; padding: 24px; border: 1px solid var(--line); background: var(--surface); border-radius: 4px; }
  .role[hidden] { display: none; }
  .js .trace-panels { position: sticky; top: calc(var(--header-h) + 24px); }
  .role-where { font-weight: 500; }
  .role-when, .role-positions { font-size: 13px; color: var(--muted); }
  .role-positions { list-style: none; display: grid; gap: 2px; }
  .role-attrs { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 4px 18px; margin: 6px 0; font-size: 13px; padding-block: 12px; border-block: 1px solid var(--line); }
  .role-attrs dt { color: var(--muted); }
  .role-attrs dd { margin: 0; }
  .role-bullets { display: grid; gap: 10px; padding-left: 18px; font-size: 16px; }
  .role-bullets li::marker { color: var(--muted); }
</style>
